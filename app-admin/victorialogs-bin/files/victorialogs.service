[Unit]
Description=VictoriaLogs - High-performance log management and analytics service
Documentation=https://docs.victoriametrics.com/victorialogs/
After=network.target

[Service]
Type=simple
User=victorialogs
Group=victorialogs
EnvironmentFile=-/etc/default/victorialogs
ExecStart=/usr/bin/victorialogs $VICTORIALOGS_OPTS
Restart=always
RestartSec=5s
LimitNOFILE=1048576
LimitNPROC=32768

[Install]
WantedBy=multi-user.target
