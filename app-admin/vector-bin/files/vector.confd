# /etc/conf.d/vector

# Configuration file to use.
# By default, /etc/vector/vector.yaml is targeted if left unset.
VECTOR_CONFIG="/etc/vector/vector.yaml"

# Additional options to pass to vector daemon
# Run `vector --help` for valid cmdline options.
VECTOR_OPTS=""

# User and group daemon runs as
VECTOR_USER="vector"
VECTOR_GROUP="vector"

# Log files
VECTOR_LOG="/var/log/vector/vector.log"
VECTOR_ERR="/var/log/vector/vector.err"
